########################################
# --- 项目大目录规则 ---
########################################

# 忽略大数据目录（如需保留结构，可在 data 放个 README.md）
/data/

# 实验日志、运行日志目录
/logs/
/tests/

# 生成的临时测试文件
utf8-test.txt

########################################
# --- Python 环境与缓存 ---
########################################

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（Windows、Linux、Mac 全支持）
.venv/
venv/
env/
ENV/

# uv 缓存目录（uv 使用时常见）
.uv/

########################################
# --- 敏感信息与配置 ---
########################################

# 环境变量文件（千万不要上传）
.env
.env.*

# 各类私钥
*.pem
*.key

########################################
# --- 操作系统与 IDE 缓存 ---
########################################

# macOS 系统文件
.DS_Store

# Windows 缓存
Thumbs.db

# VS Code 设置目录
.vscode/

# JetBrains 全家桶（PyCharm / IntelliJ）
.idea/

########################################
# --- 测试与临时文件 ---
########################################

# pytest 缓存
.pytest_cache/

# Jupyter 缓存
.ipynb_checkpoints/

# coverage 覆盖率报告
.coverage
htmlcov/

########################################
# --- 日志文件 ---
########################################

*.log